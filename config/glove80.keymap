/* Personal layout in MoErgo's 80-key physical order. */
#include <behaviors/key_press.dtsi>
#include <behaviors/transparent.dtsi>
#include <behaviors/none.dtsi>
#include <behaviors/mod_tap.dtsi>
#include <behaviors/momentary_layer.dtsi>
#include <behaviors/toggle_layer.dtsi>
#include <behaviors/to_layer.dtsi>
#include <behaviors/reset.dtsi>
#include <behaviors/rgb_underglow.dtsi>
#include <behaviors/bluetooth.dtsi>
#include <behaviors/outputs.dtsi>
#include <behaviors/macros.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define MAGIC 2
#define GAMING 3

/ {
    behaviors {
        equals_close: equals_close {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp EQUAL>, <&kp LA(F4)>;
        };
        // MoErgo's Magic: tap for indicators, hold for the control layer.
        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_status>;
        };
        // ZMK's default mod-tap timing/flavor, with a one-shot macro on hold.
        workspace_hold: workspace_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&workspace_shortcut>, <&kp>;
        };
    };

    macros {
        ZMK_MACRO(rgb_status,
            bindings = <&rgb_ug RGB_STATUS>;
        )
        // Finish the whole shortcut on press; holding the key does not repeat it.
        ZMK_MACRO1(workspace_shortcut,
            wait-ms = <0>;
            bindings = <&macro_press &kp LGUI>,
                       <&macro_param_1to1>,
                       <&macro_tap &kp MACRO_PLACEHOLDER>,
                       <&macro_release &kp LGUI>;
        )
        ZMK_MACRO(bt_0,
            wait-ms = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        )
        ZMK_MACRO(bt_1,
            wait-ms = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        )
        ZMK_MACRO(bt_2,
            wait-ms = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        )
        ZMK_MACRO(bt_3,
            wait-ms = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        )
    };

    combos {
        compatible = "zmk,combos";
        gaming_toggle_0 {
            timeout-ms = <50>;
            key-positions = <51 68>;
            layers = <0>;
            bindings = <&tog GAMING>;
        };
        gaming_toggle_3 {
            timeout-ms = <50>;
            key-positions = <51 68>;
            layers = <3>;
            bindings = <&tog GAMING>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            label = "Base";
            bindings = <
                &workspace_hold F1 F1  &workspace_hold F2 F2  &workspace_hold F3 F3  &workspace_hold F4 F4  &workspace_hold F5 F5  &kp F6  &kp F7  &kp F8  &kp F9  &mt LG(PSCRN) PSCRN
                &equals_close  &mt LS(N1) N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &mt LS(FSLH) N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
                &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LSHFT  &kp LALT  &mo 1  &kp DEL  &kp RCTRL  &kp RSHFT  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp PG_UP
                &magic MAGIC 0  &kp HOME  &kp END  &kp LEFT  &kp RIGHT  &kp SPACE  &kp LCTRL  &kp LGUI  &kp BSPC  &kp RALT  &kp RET  &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &kp PG_DN
            >;
        };
        lower_layer {
            label = "Lower";
            bindings = <
                &none  &none  &kp C_BRI_DN  &kp C_BRI_UP  &none  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none  &kp PAUSE_BREAK
                &trans  &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp HOME  &kp LS(N9)  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp PSCRN
                &trans  &none  &none  &kp UP  &none  &kp END  &kp LS(N0)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp SLCK
                &trans  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP  &kp LS(N5)  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &none
                &trans  &kp K_CMENU  &none  &kp F11  &kp F12  &kp PG_DN  &trans  &trans  &to 0  &trans  &trans  &trans  &kp COMMA  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER  &trans
                &magic MAGIC 0  &kp CAPS  &kp INS  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N0  &kp KP_N0  &kp KP_DOT  &kp KP_ENTER  &trans
            >;
        };
        magic_layer {
            label = "Magic";
            bindings = <
                &bt BT_CLR  &none  &none  &none  &none  &none  &none  &none  &none  &bt BT_CLR_ALL
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &rgb_ug RGB_SPI  &none  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &none  &none  &none  &none  &none  &none
                &bootloader  &rgb_ug RGB_SPD  &none  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &none  &none  &none  &none  &none  &bootloader
                &sys_reset  &none  &none  &none  &none  &none  &bt_2  &bt_3  &none  &none  &none  &none  &none  &none  &none  &none  &none  &sys_reset
                &none  &none  &none  &none  &none  &bt_0  &bt_1  &out OUT_USB  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
        gaming_layer {
            label = "Gaming";
            bindings = <
                &kp ESC  &kp P  &kp O  &kp N  &kp BSPC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &kp M  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &kp I  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp F12
                &kp T  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp G  &kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp LSHFT  &kp LALT  &kp V  &kp ESC  &kp UP  &kp RET  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                &kp B  &kp LCTRL  &kp Z  &kp X  &kp C  &kp SPACE  &kp LCTRL  &kp RET  &kp LEFT  &kp DOWN  &kp RIGHT  &kp MINUS  &kp LBKT  &kp RBKT  &kp EQUAL  &kp GRAVE
            >;
        };
    };
};
